{
  "name": "nucleo-clicker",
  "productName": "Nucleo Clicker",
  "version": "1.4.4",
  "description": "Núcleo Clicker — jogo clicker/idle completo para Windows com servidor online: conteúdo ao vivo, pagamentos Pix (Mercado Pago), save na nuvem e ranking global.",
  "author": "Nucleo Games",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run typecheck && npm run gen:icon && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron --format=cjs --out-extension:.js=.cjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:receipt-keys": "node scripts/gen-receipt-keys.mjs",
    "content:export": "node scripts/export-content.mjs",
    "android:sync": "vite build && cap sync android",
    "android:icons": "node scripts/gen-android-icons.mjs",
    "android:splash": "node scripts/gen-splash.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis",
    "server": "npm --prefix server run start",
    "server:dev": "npm --prefix server run dev",
    "dist:signed": "npm run check:signing && npm run build && electron-builder --win nsis",
    "check:signing": "node scripts/check-signing.mjs",
    "check:env": "node scripts/check-env.mjs",
    "dist:dir": "npm run build && electron-builder --win dir x64",
    "dist:release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nucleo.clicker",
    "productName": "NucleoClicker",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Clicker-${version}-setup.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nucleo Clicker",
      "uninstallDisplayName": "Nucleo Clicker",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Alemaozin404",
        "repo": "projeto-almanak",
        "releaseType": "release"
      }
    ]
  }
}
