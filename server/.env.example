# ── Mercado Pago (obrigatório p/ pagamentos) ──
# Access token de PRODUÇÃO (APP_USR-...) ou TEST (TEST-...).
# NUNCA coloque este token no app do jogador — ele vive apenas aqui.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx

# Secret do webhook — painel Mercado Pago → Suas integrações → Webhooks.
# Usado para validar a assinatura HMAC das notificações (x-signature).
MERCADO_PAGO_WEBHOOK_SECRET=

# Segredo compartilhado app→backend (proteção leve contra chamadas externas).
# Deve bater com GameConfig.wallet.appSharedSecret do jogo.
APP_SHARED_SECRET=nucleoclicker-pix-v1

# Chave PRIVADA Ed25519 (seed 32 bytes hex) dos recibos do Passe Premium.
# Gere com `npm run gen:receipt-keys` — a pública vai em
# GameConfig.pass.receiptPublicKey (novo build do app). O app só conhece a
# pública; esta chave vive SÓ aqui. OBRIGATÓRIA: sem ela o recibo não é emitido.
# ⚠️ A seed abaixo é apenas um EXEMPLO de dev — gere a SUA.
RECEIPT_PRIVATE_KEY=

# URL pública deste servidor (sem barra final).
# O Mercado Pago usa ${BASE_URL}/api/pix/webhook como notification_url.
# No Vercel: https://seu-projeto.vercel.app
BASE_URL=http://localhost:8787

# ── E-mail da conta (Gmail — confirmação, agradecimento e recuperação) ──
# O jogo envia os e-mails do sistema de contas com ESTA conta Gmail (remetente).
# Como criar a senha de app: conta Google → Segurança → Verificação em 2 etapas
# (ativa) → Senhas de app → gerar para "Correio".
# Sem estas variáveis o servidor roda em MODO DEV: os e-mails vão para o console
# e o código aparece em `devCode` na resposta (útil para testar o fluxo).
GMAIL_USER=seu.jogo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Upstash Redis (opcional — save na nuvem + ranking online) ──
# console.upstash.com → seu database → REST API → Copiar URL / Token.
# Sem estas variáveis, saves/ranking ficam em memória (somem ao reiniciar).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Porta do servidor (dev local)
PORT=8787
